# Copy to .env and adjust as needed. All values have safe development defaults.
APP_NAME="Autonomous AI Sales Agent"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./nerdy_sales.db
LOG_LEVEL=INFO

# --- Voice pipeline (Phase 2) ---
# Required to run the voice demo. Without them, /voice/offer returns 503.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Non-secret tunables (model, voice) live in backend/config.toml.
