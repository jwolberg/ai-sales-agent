# Copy to .env and adjust as needed. All values have safe development defaults.
APP_NAME="Autonomous AI Sales Agent"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./nerdy_sales.db
LOG_LEVEL=INFO

# --- Voice pipeline (Phase 2) ---
# Required to run the voice demo. Without them, /voice/offer returns 503.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Non-secret tunables (model, voice) live in backend/config.toml.

# --- LLM brain (optional) ---
# Enables the OpenAI tool-calling brain. Without it, the offline RuleBrain is used.
OPENAI_API_KEY=

# --- Telephony (optional, Twilio) ---
# Required only for the inbound/outbound phone integration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # E.164 sender, e.g. +15551234567

# --- Payments (optional, Stripe) ---
# Required only for the pay-by-text hooks.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_CURRENCY=usd        # optional (default usd)
